    <body>
        <h1>Equal width column grid</h1>
        <div class="container">            
        <div class="row"></div><div class="col">Column 1</div>
        <div class="row"></div> <div class="col">Column 2</div>
        <div class="row"></div><div class="col">Column 3</div>
        </div>
    </body>
